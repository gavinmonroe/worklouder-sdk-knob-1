  "layout": {
    "background": {
      "align": "center",
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 310
    },
    "pet": {
      "align": "center",
      "x": 0,
      "y": 0
    },
    "wpm": {
      "align": "top-mid",
      "x": 0,
      "y": 3
    },
    "analytics": {
      "align": "bottom-mid",
      "x": 0,
      "y": -3,
      "format": "Avg ###\nTop: ###"
    }
  },
  "stateMachine": {
    "input": "native-wpm-float",
    "behavior": "semantic-wpm-idle-v1",
    "states": [
      "ready",
      "curious",
      "happy",
      "zooming",
      "fire",
      "tired",
      "waiting",
      "sleeping"
    ]
  },
  "input": {
    "scope": "controller-local",
    "screenId": 7,
    "vtableSlot": 9,
    "chord": "fn+bottom-encoder",
    "encoder": {
      "id": 1,
      "clockwise": "next",
      "counterclockwise": "previous",
      "deltaEncoding": "zero-extended-signed-i8",
      "wrap": true
    },
    "selectionStorage": "controller-ram-only",
    "resetOn": "reboot",
    "globalKeyHook": false,
    "hardwareAccess": false
  },
  "style": {
    "wpmColors": {
      "idle": "#8fb8ff",
      "low": "#79a6ff",
      "medium": "#63e6ff",
      "high": "#ffee88"
    }
  },
  "timing": {
    "uiTickMs": 100,
    "sampleEveryTicks": 5,
    "twinkleEveryTicks": 10
  },
  "firmware": {
    "base": "live-tested-stage3c1",
    "assembly": "src/widget.S.tmpl",
    "linker": "src/widget.ld.tmpl"
  }
}
